{
  "name": "tokviz",
  "version": "0.2.0",
  "private": true,
  "description": "Token usage tracker and shell output compressor for Cursor, Copilot, and Gemini CLI",
  "license": "UNLICENSED",
  "author": "Zahra Maaziz",
  "repository": {
    "type": "git",
    "url": "https://github.com/maazizit/tokviz.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @tokviz/cli run dev",
    "test": "pnpm -r run test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck"
  },
  "keywords": [
    "cursor",
    "copilot",
    "gemini",
    "tokens",
    "ai",
    "developer-tools"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4"
  }
}
